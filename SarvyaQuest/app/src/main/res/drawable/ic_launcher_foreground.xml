<?xml version="1.0" encoding="utf-8"?>
<!--
    SARVYA QUEST App Icon
    Futuristic neon shield with a glowing "S" rune and circuit accents
    All shapes use <path> only (no <circle> — not valid in vector drawables)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer glow ring (approximated as filled path) -->
