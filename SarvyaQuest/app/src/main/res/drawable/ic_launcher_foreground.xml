    <!-- Corner accent marks top-right -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFD700"
        android:strokeWidth="1.5"
        android:pathData="M80,28 L80,22 L74,22"/>

    <!-- Star sparkle left (diamond) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M20,54 L22,57 L20,60 L18,57 Z"/>

    <!-- Star sparkle right (diamond) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M88,54 L90,57 L88,60 L86,57 Z"/>

    <!-- Bottom center dot (diamond) -->
    <path
        android:fillColor="#FFD700"
