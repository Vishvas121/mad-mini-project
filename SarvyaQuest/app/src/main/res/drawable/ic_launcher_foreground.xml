    <path
        android:fillColor="#BF00FF"
        android:pathData="M38,44 L40,46 L38,48 L36,46 Z"/>

    <!-- Circuit dot right -->
    <path
        android:fillColor="#BF00FF"
        android:pathData="M70,44 L72,46 L70,48 L68,46 Z"/>

    <!-- Top center dot (diamond) -->
    <path
        android:fillColor="#00F5FF"
        android:pathData="M54,20 L56,22 L54,24 L52,22 Z"/>

    <!-- "S" rune glow (wider, lower opacity) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#4400F5FF"
